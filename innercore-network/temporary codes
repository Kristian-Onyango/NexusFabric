func (si *SystemIntegrator) Stop() {
	si.mu.Lock()
	defer si.mu.Unlock()

	if !si.running {
		return
	}

	fmt.Println("\n[SHUTDOWN] Graceful shutdown initiated...")
	si.running = false
	message.Close()
	fmt.Println("[SHUTDOWN] System stopped.")
}

