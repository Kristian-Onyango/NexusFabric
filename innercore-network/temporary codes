package innercore

import (
	"fmt"
	"sync"
	"time"

	"innercore-network/network"
	"innercore-network/types"
)

// Lookup performs real iterative Kademlia lookup
func (ic *InnerCore) Lookup(target types.NodeID) ([]PeerInfo, error) {
	fmt.Printf("[KADEMLIA] Starting lookup for target %s\n", target)

	alpha := 3
	closest := ic.getAlphaClosest(target, alpha)

	// Fallback to network table if k-buckets are empty
	if len(closest) == 0 {
		fmt.Println("[KADEMLIA] No peers in k-buckets, falling back to network table")
		peers := network.GetAllPeers()
		for _, p := range peers {
			closest = append(closest, PeerInfo{
				NodeID:       p.NodeID,
				IP:           p.IP,
				Capabilities: p.Capabilities,
				LastSeen:     p.LastSeen,
				Score:        p.Score,
			})
		}
	}

	var result []PeerInfo
	seen := make(map[types.NodeID]bool)
	start := time.Now()
	maxIterations := 10

	for iteration := 0; len(closest) > 0 && iteration < maxIterations && time.Since(start) < 8*time.Second; iteration++ {
		fmt.Printf("[KADEMLIA] Iteration %d | Checking %d peers\n", iteration, len(closest))

		var wg sync.WaitGroup
		responses := make(chan []PeerInfo, alpha)

		for _, p := range closest {
			if seen[p.NodeID] {
				continue
			}
			seen[p.NodeID] = true

			wg.Add(1)
			go func(peer PeerInfo) {
				defer wg.Done()

				ic.SendFindNode(peer.NodeID, target)

				// Use local view for now (real response parsing comes next)
				resp := ic.getLocalClosest(peer.NodeID, target, 20)
				responses <- resp
			}(p)
		}

		wg.Wait()
		close(responses)

		newClosest := make([]PeerInfo, 0)
		for resp := range responses {
			newClosest = append(newClosest, resp...)
		}

		// Supernode fallback only if truly stalled
		if len(newClosest) == 0 && len(ic.supernodes) > 0 {
			fmt.Println("[KADEMLIA] Lookup stalled → using supernodes")
			for _, sn := range ic.supernodes {
				newClosest = append(newClosest, sn)
			}
		}

		closest = newClosest
		result = append(result, newClosest...)
	}

	// Always include self
	result = append(result, PeerInfo{
		NodeID:   ic.nodeID,
		IP:       "127.0.0.1",
		LastSeen: time.Now().Unix(),
		Score:    100.0,
	})

	fmt.Printf("[KADEMLIA] Lookup completed. Found %d peers\n", len(result))
	return result, nil
}

