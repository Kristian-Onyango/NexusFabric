type SystemIntegrator struct {
	innerCore   *innercore.InnerCore
	resolver    *resolver.Layer2Resolver
	gateway     *fallback.InternetGateway
	running     bool
	startupTime time.Time
	mu          sync.RWMutex
}

var (
	integrator *SystemIntegrator
	once       sync.Once
)

func Init() {
	once.Do(func() {
		integrator = &SystemIntegrator{
			startupTime: time.Now(),
		}

		fmt.Println("\n=== Starting Local-First InnerCore Mesh ===")

		// 1. Storage (Layer 5)
		fmt.Println("[BOOT] Initializing Layer 5 Storage...")
		storage.InitializeStorage()

		// 2. Discovery FIRST (Layer 1) - NodeID must be loaded before InnerCore
		fmt.Println("[BOOT] Initializing Layer 1 Discovery...")
		discovery.Init([]string{"chat"}, 5000)

		// 3. InnerCore (Layer 1.5)
		fmt.Println("[BOOT] Initializing InnerCore (Kademlia + Supernodes)...")
		integrator.innerCore = innercore.New(
			storage.GlobalStorage.GetEngine(),
			message.SendPacket,
		)

		// === CRITICAL WIRES ===
		discovery.UpdateNetworkCallback = func(nodeID types.NodeID, ip string, name string, caps types.Capabilities, services []string, servicePort int) {
			network.UpdateNode(nodeID, ip, name, caps, services, servicePort)
			integrator.innerCore.SeedPeer(nodeID, ip, caps)
		}

		// Register ourselves in the network table so self-lookup works
		selfID := discovery.GetMyNodeID()
		network.UpdateNode(selfID, "127.0.0.1", discovery.GetMyNodeName(), types.Capabilities{
			InternetAccess:      true,
			CrossNetworkBridge:  true,
			HotspotCapable:      true,
			UplinkBandwidthMbps: 100,
			LatencyMs:           5,
			UptimeSeconds:       3600,
		}, []string{"chat"}, 5000)

		// 4. Messaging (Layer 4)
		fmt.Println("[BOOT] Initializing Layer 4 Messaging...")
		message.Init()

		// 5. Service Registry (Layer 3)
		fmt.Println("[BOOT] Initializing Layer 3 Service Registry...")
		service.Init()

		// 6. Resolver (Layer 2)
		fmt.Println("[BOOT] Initializing Layer 2 Name Resolver...")
		integrator.resolver = resolver.NewLayer2Resolver()

		// 7. Internet Gateway (Layer 6)
		fmt.Println("[BOOT] Initializing Layer 6 Internet Fallback Gateway...")
		integrator.gateway = fallback.NewInternetGateway("0.0.0.0", 8080, integrator.innerCore)
		integrator.gateway.Start()

		integrator.running = true

		fmt.Println("\n✅ System successfully started!")
		fmt.Printf("   Node ID   : %s\n", discovery.GetMyNodeID())
		fmt.Printf("   Node Name : %s\n", discovery.GetMyNodeName())
		fmt.Println("   Status    : Operational")
	})
}

func GetInstance() *SystemIntegrator {
